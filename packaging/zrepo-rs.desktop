[Desktop Entry]
Type=Application
Version=1.5
Name=zrepo-rs
GenericName=Lanceur de projets
Comment=Ouvrir un projet local, distant ou GitHub dans Zed ou Herdr
Exec=@ZREPO_RS_BIN@
